Pv6 address for matching: N\/A\n23:10:27.334697 [Rule] Sub-rule matched: IP-CIDR(in ChinaIPs_rules_34a9221fa066bb18.list)\n23:10:27.334717 [Rule] Rule matched: RULE-SET ChinaIPs_rules_34a9221fa066bb18.list\n23:10:27.352563 [HTTP] Reuse previous connection: SGHTTPOutgoingConnectionH2-2588\n23:10:27.352596 [HTTP] HTTP protocol negotiation completed: HTTP\/2"},{"startedDateTime":"2026-11-26T23:10:26+08:00","time":249.89414215087891,"timings":{"send":0,"connect":28,"dns":65,"wait":0,"receive":154.89414215087891},"cache":{},"request":{"method":"GET","bodySize":-185,"serverIPAddress":"39.106.7.71","headersSize":532,"cookies":[],"headers":[{"name":":authority","value":"longball.longhu.net"},{"name":"sec-fetch-dest","value":"document"},{"name":"user-agent","value":"Mozilla\/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit\/605.1.15 (KHTML, like Gecko) Mobile\/15E148 &MAIAWebKit_iOS_com.longfor.supera123_1.31.1_202611201055_Default_3.3.1.0"},{"name":"accept","value":"text\/html,application\/xhtml+xml,application\/xml;q=0.9,*\/*;q=0.8"},{"name":"sec-fetch-site","value":"none"},{"name":"sec-fetch-mode","value":"navigate"},{"name":"accept-language","value":"zh-CN,zh-Hans;q=0.9"},{"name":"priority","value":"u=0, i"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"}],"queryString":[{"name":"sazgfrom","value":"component"}],"httpVersion":"HTTP\/2","url":"https:\/\/longball.longhu.net\/gf-longcoin-mobile-h5\/?sazgfrom=component"},"response":{"status":200,"bodySize":3914,"content":{"text":"<!DOCTYPE html><html lang=en><head><meta charset=utf-8><meta http-equiv=X-UA-Compatible content=\"IE=edge\"><meta name=viewport content=\"width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\"><link rel=icon href=static\/favicon.ico><title>&nbsp;<\/title><script id=MAIAAPM src=https:\/\/s.longfor.com\/public\/js\/maia-apm\/1.0\/maia-apm-sdk.js><\/script><script src=https:\/\/s.longfor.com\/const-id\/const-id.js><\/script><script src=https:\/\/s.longfor.com\/dx-captcha\/index.js><\/script><script>\/\/ APM初使化\n      try {\n        if (MAIAAPM && MAIAAPM.init) {\n          var MAIAOBJ = {\n            key: 'K1HjnUKEiqU', \/\/ 应⽤识别key，必须\n            debug: true, \/\/ 是否测试环境,默认是\n            cors_domains: [] \/\/ 跨域接口域名列表\n          }\n          if (\n            window.location.host == 'longcoin.longhu.net' ||\n            window.location.host == 'longball.longhu.net'\n          ) {\n            MAIAOBJ = {\n              key: 'X3uMs5ZM4Dg', \/\/ 应⽤识别key，必须\n              debug: false, \/\/ 是否测试环境,默认是\n              cors_domains: [] \/\/ 跨域接口域名列表\n            }\n          }\n          MAIAAPM.init(MAIAOBJ)\n        }\n      } catch (e) {\n        console.log(e)\n      }\n\n      try {\n        function getQuery(url) {\n          var obj = {}\n          url.replace(\/([^?&=]+)=([^&#]+)\/g, function(_, k, v) {\n            obj[k] = v\n          })\n          return obj\n        }\n        var queryObj = getQuery(window.location.href)\n        if (queryObj.preview !== '1') {\n          var ua = navigator.userAgent\n          var ipad = ua.match(\/(iPad).*OS\\s([\\d_]+)\/),\n            isIphone = !ipad && ua.match(\/(iPhone\\sOS)\\s([\\d_]+)\/),\n            isAndroid = ua.match(\/(Android)\\s+([\\d.]+)\/),\n            isHarmony = ua.match(\/(OpenHarmony)\\s+([\\d.]+)\/),\n            isMIniProgram = window.__wxjs_environment === 'miniprogram',\n            isMobile = isIphone || isAndroid || isHarmony || isMIniProgram\n          if (window.location.hostname != 'localhost' && !isMobile) {\n            alert('暂不支持在PC端登录珑珠，请在手机端打开使用，谢谢支持。')\n            window.opener = null\n            window.open(' ', '_self')\n            window.location.href = 'about:blank'\n            window.close()\n          }\n        } else {\n          \/\/ 预览模式 珑珠管理后台嵌入H5\n          window.addEventListener('message', function(event) {\n            \/\/event.data获取传过来的数据\n            if (event.data === 'reload') {\n              window.location.reload()\n            }\n          })\n        }\n\n        \/\/ 龙信(灰度，灰度VIP)，云图梭，双湖\n        \/\/ \b兼容以上客户端跳转不传递channel buCode,\n        function handleAdaptQueryObj() {\n          \/\/ 龙信\n          if (['05', '88', '99'].includes(queryObj.businessSource)) {\n            queryObj.channel = 'M0'\n            queryObj.buCode = 'M00000'\n            return\n          }\n          \/\/ 云图梭\n          if (queryObj.businessSource === '25') {\n            queryObj.channel = 'M0'\n            queryObj.buCode = 'M00701'\n            return\n          }\n          \/\/ 双湖\n          if (queryObj.businessSource === '12') {\n            queryObj.channel = 'S2'\n            queryObj.buCode = 'S20701'\n            return\n          }\n        }\n        handleAdaptQueryObj()\n\n           \/\/ 判断内部端还是外部端\n      function checkInside() {\n        var ua = navigator.userAgent\n        if (\n          ua.indexOf('LX') !== -1 ||\n          ua.indexOf('yuntusuo') !== -1 ||\n          ua.indexOf('LFWC') !== -1\n        ) {\n          return true\n        }\n        return false\n      }\n\n      let tokenObj = JSON.parse(localStorage.getItem('tokenObj') || '{}')\n      \/\/ FIX 有部分机型跳转收银台sysType重置错误\n      if (!tokenObj.sysType && !queryObj.sysType) {\n        if (ua.indexOf('LX') !== -1) {\n          queryObj.businessSource = '05'\n          handleAdaptQueryObj()\n        }\n        if (checkInside()) {\n          queryObj.sysType = 'LONGCOIN'\n        } else {\n          queryObj.sysType = 'WALLET'\n        }\n      }\n\n      try {\n          if (queryObj.extandParams) {\n            queryObj.extandParams = JSON.parse(decodeURIComponent(queryObj.extandParams))\n          }\n      } catch (e) {}\n\n      \/\/ FIX 大转盘跳转收银台重置url\n      queryObj = Object.assign(tokenObj, queryObj)\n      localStorage.setItem('tokenObj', JSON.stringify(queryObj))\n\n        \/\/ 组合收银台返回时不会带sysType和businessSource\n        \/\/ if (\n        \/\/   !!queryObj &&\n        \/\/   ((queryObj.token && queryObj.token !== 'null' && queryObj.token !== 'undefined') ||\n        \/\/     (queryObj.disposableKey &&\n        \/\/       queryObj.disposableKey !== 'null' &&\n        \/\/       queryObj.disposableKey !== 'undefined'))\n        \/\/ ) {\n        \/\/   if (!queryObj.sysType) {\n        \/\/     if (!queryObj.businessSource || queryObj.businessSource === '05') {\n        \/\/       queryObj.businessSource = '05'\n        \/\/       queryObj.sysType = 'LONGCOIN'\n        \/\/       handleAdaptQueryObj()\n        \/\/     } else {\n        \/\/       queryObj.sysType = 'WALLET'\n        \/\/     }\n        \/\/   }\n\n        \/\/ }\n\n        try {\n          \/\/ 中信APP跳转添加参数\n          if (queryObj.businessSource == '101') {\n            let tokenObj\n            try {\n              tokenObj = JSON.parse(localStorage.getItem('tokenObj') || '{}')\n            } catch (e) {\n              tokenObj = {}\n            }\n            queryObj = Object.assign(queryObj, tokenObj)\n            let lbReturnUrl = window.location.href.replace('\/#\/home', '\/#\/zhongxinLogin')\n            let reUrl = 'sourceClient=1&redirectUrl=' + encodeURIComponent(window.location.href)\n            if (lbReturnUrl.indexOf('?') < 0) {\n              lbReturnUrl = lbReturnUrl + '?' + reUrl\n            } else {\n              if (lbReturnUrl.lastIndexOf('&') === lbReturnUrl.length - 1) {\n                lbReturnUrl = lbReturnUrl + '' + reUrl\n              } else {\n                lbReturnUrl = lbReturnUrl + '&' + reUrl\n              }\n            }\n            queryObj.lbReturnUrl = lbReturnUrl\n            localStorage.setItem('tokenObj', JSON.stringify(queryObj))\n            if (!queryObj.token) {\n              window.location.href = lbReturnUrl\n            }\n          }\n        } catch (e) {}\n        \/\/ var lxJS = document.createElement('script');  \/\/创建一个script标签\n        \/\/ if (queryObj.sysType === 'LONGCOIN') {\n        \/\/   lxJS.src = \"https:\/\/lch.longfor.com\/jsbridge3.0\/lxjsSdk.js\"\n        \/\/ } else if (queryObj.businessSource == '01' || queryObj.businessSource == '02' || queryObj.businessSource == '06') {\n        \/\/   lxJS.src = \"https:\/\/res.wx.qq.com\/open\/js\/jweixin-1.6.0.js\"\n        \/\/ } else if (queryObj.businessSource == '09') {\n        \/\/   lxJS.src = \"https:\/\/s.longfor.com\/public\/js\/starh5-2.0-1.0.8.js\"\n        \/\/ }\n        \/\/ document.body.appendChild(lxJS);\n      } catch (e) {\n        console.error(e)\n      }<\/script><script>var containerEnv = 'browser'\n      function runByContainerEnv(params) {\n        function run() {\n          var callback = params[containerEnv]\n          var browserCallback = params.browser\n          if (callback) {\n            if (containerEnv === 'unionpay') {\n              upsdk.pluginReady(callback)\n            } else {\n              callback()\n            }\n          } else if (browserCallback) {\n            browserCallback()\n          }\n        }\n        switch (containerEnv) {\n          case 'wechat':\n            wx.miniProgram.getEnv(function (res) {\n              containerEnv = res.miniprogram ? 'wechatMiniprogram' : 'wechatBrowser'\n              run()\n            })\n            break\n          case 'alipay':\n            my.getEnv(function (res) {\n              containerEnv = res.miniprogram ? 'alipayMiniProgram' : 'alipayBrowser'\n              run()\n            })\n            break\n          default:\n            run()\n        }\n      }\n      !function () {\n        var ua = navigator.userAgent.toLowerCase()\n        var jsUrl\n        function uaIncludes(str) {\n          return ua.indexOf(str.toLowerCase()) > -1\n        }\n        if (uaIncludes('MicroMessenger')) {\n          containerEnv = 'wechat'\n          jsUrl = 'https:\/\/res.wx.qq.com\/open\/js\/jweixin-1.6.0.js'\n        } else if (uaIncludes('AliApp')) {\n          containerEnv = 'alipay'\n          jsUrl = 'https:\/\/appx\/web-view.min.js'\n        } else if (uaIncludes('MAIA')) {\n          containerEnv = 'maia'\n        } else if (uaIncludes('com.unionpay.chsp') || uaIncludes('com.unionpay.mobilepay')) {\n          containerEnv = 'unionpay'\n          jsUrl = 'https:\/\/open.95516.com\/s\/open\/js\/upsdk.js'\n        }\n        if (jsUrl) {\n          document.writeln('<script src=\"' + jsUrl + '\"><\\\/script>')\n        }\n      }()<\/script><link href=static\/css\/chunk-vendors.8e08d8ab.css rel=stylesheet><link href=static\/css\/main.933c435a.css rel=stylesheet><\/head><body style=\"-webkit-overflow-scrolling: unset;\"><script src=static\/js\/lxjsSdk.js><\/script><script src=static\/js\/zhuge.js><\/script><script src=static\/js\/preloadjs.min.js><\/script><script src=static\/js\/starh5-2.0-1.0.8.js><\/script><script defer src=https:\/\/ly-sta.longhu.net\/const-id.js><\/script><script defer src=https:\/\/ly-sta.longhu.net\/dx-captcha\/index.js><\/script><script src=static\/js\/im-sdk.js><\/script><script>try {\n        let returl = window.location.href\n        try {\n          function delQuery(url, key) {\n            var delUrl = ''\n            url.replace(\/([^?&=]+)=([^&#]+)\/g, function(_, k, v) {\n              if (k === key) delUrl = k + '=' + v\n            })\n            return url.replace(delUrl, '')\n          }\n          returl = delQuery(returl, 'token')\n        } catch (e) {}\n        if (window.location.href.indexOf('\/#\/webviewShare') >= 0) {\n          localStorage.setItem('returl', returl.replace('\/#\/webviewShare', '\/#\/home'))\n        } else {\n          localStorage.setItem('returl', returl)\n        }\n      } catch (e) {\n        localStorage.setItem('returl', returl)\n      }\n      try {\n        queryObj = JSON.parse(localStorage.getItem('tokenObj') || '{}')\n        var usercode = queryObj.usercode\n        var token = queryObj.token\n        if (!!usercode && usercode != undefined) {\n          localStorage.setItem('gf-usercode', usercode)\n          try {\n            window.MAIAAPM && window.MAIAAPM.setUid(usercode)\n          }catch (e) {}\n        }\n        if (!!token && token != undefined) {\n          localStorage.setItem('gf-token', token)\n        }\n      } catch (e) {}\n      try {\n        if (queryObj.sysType === 'LONGCOIN') {\n          zhuge.identify(queryObj.usercode, {\n            name: queryObj.usercode,\n            lmId: queryObj.longminId || '',\n          })\n          zhuge.setSuperProperty({\n            name: queryObj.usercode,\n            lmId: queryObj.longminId || '',\n            businessSource: queryObj.businessSource,\n            sysType: queryObj.sysType,\n            ua: window.navigator.userAgent\n          })\n        }\n\n        if (queryObj.sysType === 'WALLET') {\n          zhuge.identify(queryObj.longminId, {\n            name: queryObj.longminId,\n            lmId: queryObj.longminId,\n          })\n          zhuge.setSuperProperty({\n            name: queryObj.longminId,\n            lmId: queryObj.longminId,\n            businessSource: queryObj.businessSource,\n            sysType: queryObj.sysType,\n            ua: window.navigator.userAgent\n          })\n        }\n      } catch (e) {\n        console.log(e)\n      }\n      var userCode = localStorage.getItem('gf-usercode')\n      \/\/ 对createIfm适配\n      \/\/ TODO delete 龙信下架可删除\n      if (window.location.host.indexOf('localhost') < 0) {\n        try {\n          if (queryObj.sysType !== 'LONGCOIN') {\n            window.createIfm = function(name, query) {}\n          }\n        } catch (e) {}\n      } else {\n        try {\n          window.createIfm = function(name, query) {\n            if (name === 'openNewTarget') {\n              window.open(decodeURIComponent(getQuery(query).url), '_self')\n            }\n          }\n        } catch (e) {}\n      }\n      try {\n        \/\/ 隐藏分享\n        function isWeChat() {\n          var ua = window.navigator.userAgent.toLowerCase()\n          if (ua.match(\/MicroMessenger\/i) == 'micromessenger') {\n            return true\n          } else {\n            return false\n          }\n        }\n        if (isWeChat()) {\n          function onWXBridgeReady() {\n            WeixinJSBridge.call('hideOptionMenu')\n          }\n          if (typeof WeixinJSBridge == 'undefined') {\n            if (document.addEventListener) {\n              document.addEventListener('WeixinJSBridgeReady', onWXBridgeReady, false)\n            } else if (document.attachEvent) {\n              document.attachEvent('WeixinJSBridgeReady', onWXBridgeReady)\n              document.attachEvent('onWeixinJSBridgeReady', onWXBridgeReady)\n            }\n          } else {\n            onWXBridgeReady()\n          }\n        }\n      } catch (e) {}\n\n      try {\n        \/\/ 顶象风控\n        _dx.ConstID(\n          {\n            appId:\n              \"6341e15e0d8bdb6b3d20a51fb2b7c171\",\n            server:\n              \"https:\/\/ly-sta.longhu.net\/udid\/c1\",\n            userId: JSON.parse(localStorage.getItem('tokenObj') || '{}').usercode\n          },\n          (err, id) => {\n            if (err) {\n              console.log('设备指纹生成失败', err)\n            }\n          }\n        )\n      } catch (e) {}<\/script><noscript><strong>We're sorry but longball_portal doesn't work properly without JavaScript enabled. Please enable it to continue.<\/strong><\/noscript><div id=app><\/div><script src=static\/js\/chunk-vendors.d161f63f.js><\/script><script src=static\/js\/main.14c3c211.js><\/script><\/body><\/html>","size":13858,"mimeType":"text\/html"},"headersSize":462,"cookies":[],"statusText":"OK","headers":[{"name":"date","value":"Thu, 26 Nov 2026 15:10:27 GMT"},{"name":"content-type","value":"text\/html"},{"name":"set-cookie","value":"acw_tc=276a074717957058271821939e4a13f2fc8dc8f6e2342ef04ce111c7893ff8;path=\/;HttpOnly;Max-Age=1800"},{"name":"last-modified","value":"Mon, 23 Nov 2026 09:55:19 GMT"},{"name":"vary","value":"Accept-Encoding"},{"name":"e
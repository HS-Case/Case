[TLS] TLS Client Hello SNI: longball.longhu.net\n23:10:26.942162 [MITM] Enable MITM due to capture MITM override setting entry: *\n23:10:26.963937 [MITM] MITM via HTTP\/2 mode\n23:10:27.366344 [Rule] Rule evaluating requires DNS lookup for rule: RULE-SET LAN\n23:10:27.366420 [DNS] Use cached DNS result for longball.longhu.net. A record count: 1, AAAA record count: 0\n23:10:27.366466 [Rule] DNS completed, IPv4 address for matching: 39.106.7.71, IPv6 address for matching: N\/A\n23:10:27.366518 [Rule] Sub-rule matched: IP-CIDR(in ChinaIPs_rules_34a9221fa066bb18.list)\n23:10:27.366534 [Rule] Rule matched: RULE-SET ChinaIPs_rules_34a9221fa066bb18.list\n23:10:27.373166 [HTTP] Reuse previous connection: SGHTTPOutgoingConnectionH2-2588\n23:10:27.373186 [HTTP] HTTP protocol negotiation completed: HTTP\/2"},{"startedDateTime":"2026-11-26T23:10:27+08:00","time":170.57204246520996,"timings":{"send":0,"receive":170.57204246520996,"wait":0},"cache":{},"request":{"method":"GET","bodySize":-662,"serverIPAddress":"39.106.7.71","headersSize":708,"cookies":[],"headers":[{"name":":authority","value":"longball.longhu.net"},{"name":"sec-fetch-dest","value":"script"},{"name":"user-agent","value":"Mozilla\/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit\/605.1.15 (KHTML, like Gecko) Mobile\/15E148 &MAIAWebKit_iOS_com.longfor.supera123_1.31.1_202611201055_Default_3.3.1.0"},{"name":"accept","value":"*\/*"},{"name":"referer","value":"https:\/\/longball.longhu.net\/gf-longcoin-mobile-h5\/?sazgfrom=component"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"accept-language","value":"zh-CN,zh-Hans;q=0.9"},{"name":"priority","value":"u=1, i"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"cookie","value":"SERVERID=dfdbe562970f7332a24e99339ba867f0|1795705827|1795705827"},{"name":"cookie","value":"acw_tc=276a074717957058271821939e4a13f2fc8dc8f6e2342ef04ce111c7893ff8"}],"queryString":[],"httpVersion":"HTTP\/2","url":"https:\/\/longball.longhu.net\/gf-longcoin-mobile-h5\/static\/js\/im-sdk.js"},"response":{"status":200,"bodySize":970,"content":{"text":"\nvar im = {\n\n    startChat : function (targetId, account, conversationType) {\n\n        if (!targetId && !account) {\n            console.log('targetId\/account is null');\n            alert('targetId\/account is null');\n            return;\n        }\n\n        if (!conversationType) {\n            console.log('conversationType is null');\n            alert('conversationType is null');\n            return;\n        }\n        \n        targetId = 'targetId=' + targetId + '&'\n        account = 'userAccount=' + account + '&'\n        \n        conversationType = 'conversationType=' + conversationType\n        \n        var url = 'longfor:\/\/im\/startChat?' + targetId + account + conversationType\n\n        createIframe(url);\n    },\n\n    forward : function (objectName, content, callbackName) {\n\n        if (!objectName) {\n            console.log('objectName is null');\n            alert('objectName is null');\n            return;\n        }\n\n        if (!content) {\n            console.log('content is null');\n            alert('content is null');\n            return;\n        }\n        \n        callbackName = 'callback=' + callbackName + '&'\n        objectName = 'objectName=' + encodeURIComponent(objectName) + '&'\n        content = 'content=' + encodeURIComponent(content)\n                \n        var url = 'longfor:\/\/im\/forward?' + callbackName + objectName + content\n\n        createIframe(url);\n\n    },\n\n    joinUmeet : function (numericId, isHost, hostId, hostKey, umeetToken, zak) {\n\n        if (!numericId) {\n            console.log('numericId is null');\n            alert('numericId is null');\n            return;\n        }\n        if (isHost === 1 || isHost === '1') {\n            if (!hostId || !hostKey || !umeetToken) {\n                console.log('hostId, hostKey, umeetToken is null');\n                alert('hostId, hostKey, umeetToken is null');\n                return;\n            }\n        } else {\n            isHost = '0'\n        }\n        if (!zak) {\n            console.log('zak is null');\n            \/\/alert('zak is null');\n            \/\/return;\n        }\n\n        numericId = 'numericId=' + numericId + '&'\n        isHost = 'isHost=' + isHost + '&'\n        hostId = 'hostId=' + hostId + '&'\n        hostKey = 'hostKey=' + hostKey + '&'\n        umeetToken = 'umeetToken=' + umeetToken + '&'\n        zak = 'zak=' + zak\n        \n        var url = 'longfor:\/\/im\/joinUmeet?' + numericId + isHost + hostId + hostKey + umeetToken + zak\n\n        createIframe(url);\n    },\n\n    selectOnlineDoc : function (limitCount, callbackName) {\n        if (!limitCount) {\n            console.log('limitCount is null');\n            alert('limitCount is null');\n            return;\n        }\n        if (!callbackName) {\n            console.log('callbackName is null');\n            alert('callbackName is null');\n            return;\n        }\n        \n        callbackName = 'callback=' + callbackName + '&'\n        limitCount = 'limitCount=' + limitCount\n                \n        var url = 'longfor:\/\/im\/selectOnlineDoc?' + callbackName + limitCount\n\n        createIframe(url);\n    },\n\n    getMsgContentById : function (msgId, callbackName) {\n        if (!msgId) {\n            console.log('msgId is null');\n            alert('msgId is null');\n            return;\n        }\n        if (!callbackName) {\n            console.log('callbackName is null');\n            alert('callbackName is null');\n            return;\n        }\n        \n        callbackName = 'callback=' + callbackName + '&'\n        msgId = 'msgId=' + msgId\n                \n        var url = 'longfor:\/\/im\/getMsgContentById?' + callbackName + msgId\n\n        createIframe(url);\n    },\n\n    sendFileMessages : function (targetId, conversationType, messages, callbackName) {\n\n        if (!targetId) {\n            console.log('targetId is null');\n            alert('targetId is null');\n            return;\n        }\n\n        if (!conversationType) {\n            console.log('conversationType is null');\n            alert('conversationType is null');\n            return;\n        }\n        \n        if (!messages) {\n            console.log('messages is null');\n            alert('messages is null');\n            return;\n        }\n\n        callbackName = 'callback=' + callbackName + '&'\n        targetId = 'targetId=' + targetId + '&'\n        conversationType = 'conversationType=' + conversationType + '&'\n        messages = 'messages=' + encodeURIComponent(messages)\n                \n        var url = 'longfor:\/\/im\/sendFileMessages?' + callbackName + targetId + conversationType + messages\n\n        createIframe(url);\n\n    }\n\n}\n\nfunction createIframe(url) {\n    \/\/alert(url);\n    var messagingIframe\n    messagingIframe = document.createElement('iframe')\n    messagingIframe.style.display = 'none'\n    messagingIframe.src = url\n    document.documentElement.appendChild(messagingIframe)\n    setTimeout(function() {\n        document.documentElement.removeChild(messagingIframe)\n    }, 0)\n}\n\n\/\/ var aim = {\n\/\/     joinUmeet  : function (value,callbackName) {\n        \n\/\/         if (!callbackName) {\n\/\/             callbackName = 'callback=&'\n\/\/         } else {\n\/\/             callbackName = 'callback=' + callbackName + '&'\n\/\/         }\n        \n\/\/         var url = 'longfor:\/\/im\/joinUmeet?' + callbackName + value\n        \n\/\/         createIframe(url);\n\/\/     },\n\/\/ }\n","size":5323,"mimeType":"application\/javascript"},"headersSize":303,"cookies":[],"statusText":"OK","headers":[{"name":"date","value":"Thu, 26 Nov 2026 15:10:27 GMT"},{"name":"content-type","value":"application\/javascript"},{"name":"vary","value":"Accept-Encoding"},{"name":"last-modified","value":"
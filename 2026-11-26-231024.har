nitContentJsonStr:function(e,t){e.initContentJsonStr=t},setSysType:function(e,t){e.sysType=t},pushJiafuUrl:function(e,t){var n=t.key,i=t.val;e.jiafuUrl[n]=i},setGuide:function(e,t){e.guide=t},resetGuide:function(e,t){e.guide=t||{selected:0,list:[{title:\"珑珠\",flag:!0,content:[{question:\"珑珠是什么？\",answer:\"珑珠是一种代币，是集团为员工发放的补充福利，范围包括生日、员工入职、妇女节、端午节和中秋节。\",isShow:!1},{question:\"获取珑珠的途径有哪些？\",answer:'珑珠的常规获取途径除来自集团的福利外，还包括来自其他员工的<a href=\".\/#\/transfer1\">祝福和打赏<\/a>。',isShow:!1},{question:\"我能用珑珠做什么？\",answer:'珑珠可以通过<a href=\".\/#\/transfer1\">祝福或打赏<\/a>的方式，让同事感受到来自你的关心和鼓励，也可以在<a href=\".\/#\/linkToGuanAiTong\">珑珠生活<\/a>里购买你心仪的商品。',isShow:!1},{question:\"珑珠能兑换成人民币吗？\",answer:\"不能，珑珠和人民币目前无法互相兑换。\",isShow:!1}]},{title:\"转账\",flag:!0,content:[{question:\"我能给谁转账？\",answer:'你可以为集团所有拥有OA账号的同事<a href=\".\/#\/transfer1\">转账<\/a>。',isShow:!1},{question:\"能同时给多人转账吗？\",answer:'可以，一次<a href=\".\/#\/transfer1\">转账<\/a>最多可以添加20个收款人。',isShow:!1},{question:\"单次转账有金额上限吗？\",answer:'单次<a href=\".\/#\/transfer1\">转账<\/a>最多可以为每个收款人转出10000珑珠。',isShow:!1},{question:\"转账给对方后多久可以到账？\",answer:\"即时到账。\",isShow:!1}]},{title:\"预约\",flag:!0,content:[{question:\"预约转账能帮我做什么？\",answer:'不需要知道同事的生日是哪天，你就可以为他\/她<a href=\".\/#\/orderreward1\">预定<\/a>好生日祝福，让他\/她在生日当天能准时接收到来自你的关爱。除生日外，你还可以预约<a href=\".\/#\/orderreward1\">节日祝福<\/a>和<a href=\".\/#\/orderreward1\">入职周年祝福<\/a>，以及<a href=\".\/#\/orderreward1\">预约自定义事件<\/a>。',isShow:!1},{question:\"有哪些可以预约的类型？\",answer:\"目前已经开放的预约类型包括生日、中秋节、国庆节、春节、元宵节、入职周年以及里程碑。\",isShow:!1},{question:\"我可以为谁进行预约？\",answer:'你可以为集团所有拥有OA账号的同事进行<a href=\".\/#\/orderreward1\">预约<\/a>。',isShow:!1},{question:\"单笔预约有时间限制吗？\",answer:\"除里程碑外，所有预约均无时间限制。它会一直按预约发放，直至被取消。里程碑祝福每次预约后只发放一次。\",isShow:!1},{question:\"在发放期间珑珠不足时怎么办？\",answer:\"珑珠不足以支撑一次预约发放时，系统会按预约先后次序发放至无法发放为止。之后会通过珑珠公众号告知预约人。\",isShow:!1},{question:\"怎样撤销预约？\",answer:'在<a href=\".\/#\/orderreward1?select=1\">预约编辑页面<\/a>删除即可。',isShow:!1}]},{title:\"兑换与消费\",flag:!0,content:[{question:\"珑珠怎样进行消费？\",answer:'珑珠需要先<a href=\".\/#\/integralExchange\">兑换<\/a>成积分，才能在<a href=\".\/#\/linkToGuanAiTong\">珑珠生活<\/a>中消费。',isShow:!1},{question:\"怎样进入珑珠生活？\",answer:'在龙信应用页和珑珠兑换页均可进入<a href=\".\/#\/linkToGuanAiTong\">珑珠生活<\/a>。',isShow:!1},{question:\"兑换成积分后，还可以换回珑珠吗？\",answer:'积分无法兑换回珑珠，<a href=\".\/#\/integralExchange\">兑换积分<\/a>一定要慎重哦。',isShow:!1},{question:\"如果积分不足，我怎么买到心仪的商品？\",answer:\"珑珠生活支持微信支付。\",isShow:!1}]},{title:\"其他\",flag:!0,content:[{question:\"离职后珑珠还能使用吗？\",answer:\"离职后龙信将无法再登录，对应的珑珠也无法再使用了。离职前请务必把未使用的珑珠用掉。\",isShow:!1},{question:\"珑珠出问题了，我应该找谁解决？\",answer:\"在龙小湖报事。\",isShow:!1}]},{title:\"团队珑珠\",flag:!1,content:[{question:\"我有两个账号？\",answer:\"目前珑珠系统使用个人账号和激励账号来分别管理个人珑珠和团队珑珠。\",isShow:!1},{question:\"激励账号里的钱是怎么来的？\",answer:\"由“时光胶囊”活动为您提供的。\",isShow:!1},{question:\"激励珑珠怎么用？\",answer:'激励珑珠主要用以为同事进行<a href=\".\/#\/transfer2\">激励和打赏<\/a>。基于这一范围你可以按自己的方式进行使用。',isShow:!1},{question:\"怎么更好的使用激励珑珠？\",answer:\"工作或项目的重大节点（立项、里程碑、结项），重大节假日和同事的纪念日（生日、入职周年）都是非常好的使用场景。\",isShow:!1},{question:\"龙信红包打赏或者工作圈打赏用的是哪个账号里的珑珠？\",answer:\"此类场景对账号的使用由对应产品自行决定，珑珠系统不作统一要求。\",isShow:!1}]}]}},setMoneyImg:function(e,t){e.moneyImg=t},setOrderRewardSelect:function(e,t){e.orderReward.select=t},setTransferText:function(e,t){e.transferPage.text=t},setUserInformation:function(e,t){var n=t.usercode,i=t.username;e.users.username=i,e.users.usercode=n},setUserMobile:function(e,t){e.users.mobile=t},addTransferList:function(e,t){var n;\"[object Array]\"===Object.prototype.toString.call(t)?(n=e.transferPage.transferList).push.apply(n,s(t)):e.transferPage.transferList.push(t)},deleteTransferList:function(e,t){e.transferPage.transferList=e.transferPage.transferList.filter(function(e){return e.usercode!==t})},setTransferPage:function(e,t){e.transferPage=t},clearTransferPage:function(e){var t=e.transferPage,i=t.transferType,a=t.accountType;e.transferPage={isMilepost:!1,status:0,isEdit:!0,transferType:i,jobNo:\"\",accountId:\"\",accountType:a,accountBalances:void 0,transferList:[],money:void 0,text:\"恭喜发财！\",tag:\"\",date:null,account
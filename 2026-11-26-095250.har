18\/564\/page-frame.html"}],"queryString":[{"name":"page","value":"1"},{"name":"rows","value":"10"},{"name":"uid","value":"1008586744"},{"name":"index","value":"18"}],"httpVersion":"HTTP\/1.1","url":"https:\/\/mini-prog-wt-pro.singworld.net\/api\/theme\/getThemeList?page=1&rows=10&uid=1008586744&index=18"},"response":{"status":200,"bodySize":35466,"content":{"text":"{\"success\":true,\"code\":0,\"msg\":\"\",\"data\":{\"pageNum\":1,\"pageSize\":10,\"size\":0,\"startRow\":0,\"endRow\":0,\"total\":108,\"pages\":11,\"list\":[{\"id\":61,\"name\":\"舞推视频动态权限申请通道\",\"showDesc\":1,\"themeDesc\":\"<p>舞推用户认证通道正式开放！<\/p><p><br><\/p><p>认证方式出乎意料的简单：点击「我要加推」，上传 1~2 段你最为满意的完整跳舞视频（时长不能短于 1 分钟）<\/p><p>视频要求：在e舞成名网络版、e舞成名升级版、e舞成名家用版（e5+）、e舞成名纪念版的游玩跳舞视频<\/p><p><br><\/p><p>视频通过审核后，我们将为你进行用户认证<\/p><p><br><\/p><p>认证通过后，可享受以下权利：<\/p><p>1. 视频发布权限，可以直接在舞推发布视频动态<\/p><p>2. 用户头像“达人标识”<\/p><p>3. 敬请期待<\/p>\",\"beginTime\":\"2028-03-30 00:00:00\",\"endTime\":\"2029-03-30 00:00:00\",\"applyDeadline\":\"2022-09-30 00:00:00\",\"applyCheck\":0,\"dayCount\":1,\"sameCount\":1,\"visitCount\":111084,\"optionCount\":1618,\"createTime\":\"2021-09-13 13:47:01\",\"updateTime\":\"2024-04-07 09:46:26\",\"status\":3,\"imageUrl\":\"http:\/\/dance-sky.singworld.cn\/BC\/BCE97073B9339012BF934B8C1A90F8AE7711A733D96295F8C6B4185346830B02.jpeg\",\"voteCount\":1029,\"personCount\":222,\"uid\":1000004126,\"themeType\":2,\"topFlag\":0,\"voted\":false,\"imageUrl2\":\"http:\/\/dance-sky.singworld.cn\/A1\/A1A6C8DFE0E8D6A0E26B1C59761E22BB67EE403D25D238CD9B7F62FA3C4CE37F.jpeg\",\"rstImageUrl\":\"http:\/\/dance-sky.singworld.cn\/64\/6454689FF8C124B5063589A25AB8B24217C2BBEB3109832C60246BA983219B7B.jpeg\",\"recommendNum\":99,\"redeemNum\":0,\"redeemTotalNum\":0,\"isWpl\":0,\"activityType\":1},{\"id\":754,\"name\":\"12月主题月歌曲荐歌行动\",\"showDesc\":1,\"themeDesc\":\"<h3><strong>什么是『主题月歌曲』荐歌行动？<\/strong><\/h3><p><strong>『主题月歌曲』<\/strong>荐歌行动是一个按月轮换主题<strong>『推荐歌曲』<\/strong>的推荐活动。活动设花式、竞速等模式，每月主题各异。<\/p><p>每月根据设定的主题，玩家可推荐喜爱歌曲，通过贡献<strong>『推荐值』<\/strong>，让歌曲进入<strong>『入围圈』<\/strong>；官方根据适合脚谱编创的要求再从<strong>『入围圈』<\/strong>挑选出<u>1-3首<\/u>作为<strong>『主题月歌曲』<\/strong>进行上线。<\/p><p>*花式模式的主题目前暂定为<u>中文流行、街舞、宅舞、MV原舞<\/u>这四种舞蹈风格轮换；竞速模式的主题则暂定为<u>中文流行、欧美流行、日语流行、韩文流行<\/u>这四种语种的歌曲轮换。具体主题可能会根据活动安排有所变动，请以当月官方公布的主题为准。<\/p><p><br><\/p><h3><strong>『主题月歌曲』上榜规则：<\/strong><\/h3><p>1.<strong>『推荐值』<\/strong>优先达到<u>100%<\/u>的歌曲，将稳固入驻<strong>『入围圈』<\/strong>，随后，其余歌曲将依据<strong>『推荐值』<\/strong>从高到低排序。在活动日期截止后，最终进入<strong>『入围圈』<\/strong>的<u>30首歌曲<\/u>将有机会被挑选作为<strong>『主题月歌曲』<\/strong>。<\/p><p><u>*若第30名与第31名歌曲的<\/u><strong><u>『推荐值』<\/u><\/strong><u>相同，则将依据两首歌曲达到该<\/u><strong><u>『推荐值』<\/u><\/strong><u>的时间先后顺序进行排序，从而进入<\/u><strong><u>『入围圈』<\/u><\/strong><u>。<\/u><\/p><p><br><\/p><p><strong>2.在活动结束后，官方谱师将从『入围圈』<\/strong>中精心挑选<u>1-3首<\/u>符合<u>高游玩性且同时满足适合进行脚谱编创<\/u>的歌曲作为<strong>『主题月歌曲』<\/strong><\/p><p><br><\/p><p><br><\/p><h3><strong>『推荐歌曲』的推荐规则：<\/strong><\/h3><p>1.参与者需根据当期主题推荐符合要求的歌曲。<\/p><p>2.每期主题月活动中，一个账号最多可推荐三首歌曲。<\/p><p>3.每人每天可为歌曲贡献0.1%的<strong>『推荐值』，<\/strong>严禁恶意刷<strong>『推荐值』<\/strong>行为。<\/p><p>4.推荐的歌曲将在工作日48小时内进行审核。<\/p><p><br><\/p><h3><strong>『推荐歌曲』的审核规则：<\/strong><\/h3><p>1. 歌曲重复：推荐歌曲已更新在e舞成名系列任一产品、任一模式中；<\/p><p>2. 内容错误：推荐歌曲信息错误，无法在互联网上找到该歌曲信息；<\/p><p>3. 内容不合法：推荐歌曲信息存在非法内容，或该歌曲不适合更新；<\/p><p>4. 其它原因：请留意审核结果通知提示；<\/p><p>5. 作品显示“e5已更新”，表示该作品将更新至e舞成名网络版对应的模式或DIY模式；&nbsp;<\/p><p>6. 作品显示“云曲库已更新”，表示该作品将更新至云曲库，e5+、e舞十周年纪念版和舞影随行和升级版同步更新；&nbsp;<\/p><p>7. 作品显示“全部已更新”，表示该作品将在e舞成名网络版、云曲库更新<\/p>\",\"beginTime\":\"2025-12-16 11:00:00\",\"endTime\":\"2026-01-15 23:59:59\",\"dayCount\":1,\"sameCount\":1,\"visitCount\":14343,\"optionCount\":184,\"createTime\":\"2025-12-16 09:44:54\",\"updateTime\":\"2025-12-16 09:51:12\",\"status\":3,\"imageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/2B\/2B9771A218FF915DD3109AD903AB6397B5D338D598269F303DFFA77F7D297167.jpeg\",\"voteCount\":10047,\"personCount\":1197,\"uid\":2547,\"themeType\":0,\"topFlag\":127,\"voted\":false,\"imageUrl2\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/63\/63329531041710055777E23375F1E7A9C174DA900E60274930A33E29BA332F20.jpeg\",\"rstImageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/2B\/2B9771A218FF915DD3109AD903AB6397B5D338D598269F303DFFA77F7D297167.jpeg\",\"recommendNum\":3,\"redeemNum\":0,\"redeemTotalNum\":0,\"isWpl\":0,\"activityType\":1,\"genreList\":[15,21]},{\"id\":746,\"name\":\"11月主题月歌曲荐歌行动\",\"showDesc\":1,\"themeDesc\":\"<h3><strong>什么是『主题月歌曲』荐歌行动？<\/strong><\/h3><p><strong>『主题月歌曲』<\/strong>荐歌行动是一个按月轮换主题<strong>『推荐歌曲』<\/strong>的推荐活动。活动设花式、竞速等模式，每月主题各异。<\/p><p>每月根据设定的主题，玩家可推荐喜爱歌曲，通过贡献<strong>『推荐值』<\/strong>，让歌曲进入<strong>『入围圈』<\/strong>；官方根据适合脚谱编创的要求再从<strong>『入围圈』<\/strong>挑选出<u>1-3首<\/u>作为<strong>『主题月歌曲』<\/strong>进行上线。<\/p><p>*花式模式的主题目前暂定为<u>中文流行、街舞、宅舞、MV原舞<\/u>这四种舞蹈风格轮换；竞速模式的主题则暂定为<u>中文流行、欧美流行、日语流行、韩文流行<\/u>这四种语种的歌曲轮换。具体主题可能会根据活动安排有所变动，请以当月官方公布的主题为准。<\/p><p><br><\/p><h3><strong>『主题月歌曲』上榜规则：<\/strong><\/h3><p>1.<strong>『推荐值』<\/strong>优先达到<u>100%<\/u>的歌曲，将稳固入驻<strong>『入围圈』<\/strong>，随后，其余歌曲将依据<strong>『推荐值』<\/strong>从高到低排序。在活动日期截止后，最终进入<strong>『入围圈』<\/strong>的<u>30首歌曲<\/u>将有机会被挑选作为<strong>『主题月歌曲』<\/strong>。<\/p><p><u>*若第30名与第31名歌曲的<\/u><strong><u>『推荐值』<\/u><\/strong><u>相同，则将依据两首歌曲达到该<\/u><strong><u>『推荐值』<\/u><\/strong><u>的时间先后顺序进行排序，从而进入<\/u><strong><u>『入围圈』<\/u><\/strong><u>。<\/u><\/p><p><br><\/p><p><strong>2.在活动结束后，官方谱师将从『入围圈』<\/strong>中精心挑选<u>1-3首<\/u>符合<u>高游玩性且同时满足适合进行脚谱编创<\/u>的歌曲作为<strong>『主题月歌曲』<\/strong><\/p><p><br><\/p><p><br><\/p><h3><strong>『推荐歌曲』的推荐规则：<\/strong><\/h3><p>1.参与者需根据当期主题推荐符合要求的歌曲。<\/p><p>2.每期主题月活动中，一个账号最多可推荐三首歌曲。<\/p><p>3.每人每天可为歌曲贡献0.1%的<strong>『推荐值』，<\/strong>严禁恶意刷<strong>『推荐值』<\/strong>行为。<\/p><p>4.推荐的歌曲将在工作日48小时内进行审核。<\/p><p><br><\/p><h3><strong>『推荐歌曲』的审核规则：<\/strong><\/h3><p>1. 歌曲重复：推荐歌曲已更新在e舞成名系列任一产品、任一模式中；<\/p><p>2. 内容错误：推荐歌曲信息错误，无法在互联网上找到该歌曲信息；<\/p><p>3. 内容不合法：推荐歌曲信息存在非法内容，或该歌曲不适合更新；<\/p><p>4. 其它原因：请留意审核结果通知提示；<\/p><p>5. 作品显示“e5已更新”，表示该作品将更新至e舞成名网络版对应的模式或DIY模式；&nbsp;<\/p><p>6. 作品显示“云曲库已更新”，表示该作品将更新至云曲库，e5+、e舞十周年纪念版和舞影随行和升级版同步更新；&nbsp;<\/p><p>7. 作品显示“全部已更新”，表示该作品将在e舞成名网络版、云曲库更新<\/p>\",\"beginTime\":\"2025-11-16 00:00:00\",\"endTime\":\"2025-12-15 23:59:59\",\"dayCount\":1,\"sameCount\":1,\"visitCount\":13193,\"optionCount\":137,\"createTime\":\"2025-11-14 10:45:41\",\"updateTime\":\"2025-12-29 15:28:26\",\"status\":3,\"imageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/AE\/AE1CB5AF3620E9B8D68BABB5D54E227116AC6D2FF39336C0167E6FA05647C72E.jpeg\",\"voteCount\":9365,\"personCount\":1133,\"uid\":2547,\"themeType\":0,\"topFlag\":127,\"voted\":false,\"imageUrl2\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/AF\/AF24E220C07351237DE831E86A01F1F23F6AF517AAA6A9BCF73B0223FCAD149F.jpeg\",\"rstImageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/AE\/AE1CB5AF3620E9B8D68BABB5D54E227116AC6D2FF39336C0167E6FA05647C72E.jpeg\",\"recommendNum\":3,\"redeemNum\":0,\"redeemTotalNum\":0,\"isWpl\":0,\"activityType\":1,\"genreList\":[18,22]},{\"id\":734,\"name\":\"10月主题月歌曲荐歌行动\",\"showDesc\":1,\"themeDesc\":\"<h3><strong>什么是『主题月歌曲』荐歌行动？<\/strong><\/h3><p><strong>『主题月歌曲』<\/strong>荐歌行动是一个按月轮换主题<strong>『推荐歌曲』<\/strong>的推荐活动。活动设花式、竞速等模式，每月主题各异。<\/p><p>每月根据设定的主题，玩家可推荐喜爱歌曲，通过贡献<strong>『推荐值』<\/strong>，让歌曲进入<strong>『入围圈』<\/strong>；官方根据适合脚谱编创的要求再从<strong>『入围圈』<\/strong>挑选出<u>1-3首<\/u>作为<strong>『主题月歌曲』<\/strong>进行上线。<\/p><p>*花式模式的主题目前暂定为<u>中文流行、街舞、宅舞、MV原舞<\/u>这四种舞蹈风格轮换；竞速模式的主题则暂定为<u>中文流行、欧美流行、日语流行、韩文流行<\/u>这四种语种的歌曲轮换。具体主题可能会根据活动安排有所变动，请以当月官方公布的主题为准。<\/p><p><br><\/p><h3><strong>『主题月歌曲』上榜规则：<\/strong><\/h3><p>1.<strong>『推荐值』<\/strong>优先达到<u>100%<\/u>的歌曲，将稳固入驻<strong>『入围圈』<\/strong>，随后，其余歌曲将依据<strong>『推荐值』<\/strong>从高到低排序。在活动日期截止后，最终进入<strong>『入围圈』<\/strong>的<u>30首歌曲<\/u>将有机会被挑选作为<strong>『主题月歌曲』<\/strong>。<\/p><p><u>*若第30名与第31名歌曲的<\/u><strong><u>『推荐值』<\/u><\/strong><u>相同，则将依据两首歌曲达到该<\/u><strong><u>『推荐值』<\/u><\/strong><u>的时间先后顺序进行排序，从而进入<\/u><strong><u>『入围圈』<\/u><\/strong><u>。<\/u><\/p><p><br><\/p><p><strong>2.在活动结束后，官方谱师将从『入围圈』<\/strong>中精心挑选<u>1-3首<\/u>符合<u>高游玩性且同时满足适合进行脚谱编创<\/u>的歌曲作为<strong>『主题月歌曲』<\/strong><\/p><p><br><\/p><p><br><\/p><h3><strong>『推荐歌曲』的推荐规则：<\/strong><\/h3><p>1.参与者需根据当期主题推荐符合要求的歌曲。<\/p><p>2.每期主题月活动中，一个账号最多可推荐三首歌曲。<\/p><p>3.每人每天可为歌曲贡献0.1%的<strong>『推荐值』，<\/strong>严禁恶意刷<strong>『推荐值』<\/strong>行为。<\/p><p>4.推荐的歌曲将在工作日48小时内进行审核。<\/p><p><br><\/p><h3><strong>『推荐歌曲』的审核规则：<\/strong><\/h3><p>1. 歌曲重复：推荐歌曲已更新在e舞成名系列任一产品、任一模式中；<\/p><p>2. 内容错误：推荐歌曲信息错误，无法在互联网上找到该歌曲信息；<\/p><p>3. 内容不合法：推荐歌曲信息存在非法内容，或该歌曲不适合更新；<\/p><p>4. 其它原因：请留意审核结果通知提示；<\/p><p>5. 作品显示“e5已更新”，表示该作品将更新至e舞成名网络版对应的模式或DIY模式；&nbsp;<\/p><p>6. 作品显示“云曲库已更新”，表示该作品将更新至云曲库，e5+、e舞十周年纪念版和舞影随行和升级版同步更新；&nbsp;<\/p><p>7. 作品显示“全部已更新”，表示该作品将在e舞成名网络版、云曲库更新<\/p>\",\"beginTime\":\"2025-10-16 16:00:00\",\"endTime\":\"2025-11-15 23:59:59\",\"dayCount\":1,\"sameCount\":1,\"visitCount\":12489,\"optionCount\":84,\"createTime\":\"2025-10-16 14:53:50\",\"updateTime\":\"2025-11-27 11:19:06\",\"status\":3,\"imageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/B3\/B3940CE02A7711109728068085849CF425AA52986E17F92C69E44B667F7E0878.jpeg\",\"voteCount\":8541,\"personCount\":972,\"uid\":2547,\"themeType\":0,\"topFlag\":126,\"voted\":false,\"imageUrl2\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/C2\/C27545742D8F3537B730F0BCB7A6AAC85751B80A068E2AF61E2569319941A7BA.jpeg\",\"rstImageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/B3\/B3940CE02A7711109728068085849CF425AA52986E17F92C69E44B667F7E0878.jpeg\",\"recommendNum\":3,\"redeemNum\":0,\"redeemTotalNum\":0,\"isWpl\":0,\"activityType\":1,\"genreList\":[16,20]},{\"id\":729,\"name\":\"9月主题月歌曲荐歌行动\",\"showDesc\":1,\"themeDesc\":\"<h3><strong>什么是『主题月歌曲』荐歌行动？<\/strong><\/h3><p><strong>『主题月歌曲』<\/strong>荐歌行动是一个按月轮换主题<strong>『推荐歌曲』<\/strong>的推荐活动。活动设花式、竞速等模式，每月主题各异。<\/p><p>每月根据设定的主题，玩家可推荐喜爱歌曲，通过贡献<strong>『推荐值』<\/strong>，让歌曲进入<strong>『入围圈』<\/strong>；官方根据适合脚谱编创的要求再从<strong>『入围圈』<\/strong>挑选出<u>1-3首<\/u>作为<strong>『主题月歌曲』<\/strong>进行上线。<\/p><p>*花式模式的主题目前暂定为<u>中文流行、街舞、宅舞、MV原舞<\/u>这四种舞蹈风格轮换；竞速模式的主题则暂定为<u>中文流行、欧美流行、日语流行、韩文流行<\/u>这四种语种的歌曲轮换。具体主题可能会根据活动安排有所变动，请以当月官方公布的主题为准。<\/p><p><br><\/p><h3><strong>『主题月歌曲』上榜规则：<\/strong><\/h3><p>1.<strong>『推荐值』<\/strong>优先达到<u>100%<\/u>的歌曲，将稳固入驻<strong>『入围圈』<\/strong>，随后，其余歌曲将依据<strong>『推荐值』<\/strong>从高到低排序。在活动日期截止后，最终进入<strong>『入围圈』<\/strong>的<u>30首歌曲<\/u>将有机会被挑选作为<strong>『主题月歌曲』<\/strong>。<\/p><p><u>*若第30名与第31名歌曲的<\/u><strong><u>『推荐值』<\/u><\/strong><u>相同，则将依据两首歌曲达到该<\/u><strong><u>『推荐值』<\/u><\/strong><u>的时间先后顺序进行排序，从而进入<\/u><strong><u>『入围圈』<\/u><\/strong><u>。<\/u><\/p><p><br><\/p><p>2.在活动结束后，官方谱师将从<strong>『入围圈』<\/strong>中精心挑选<u>1-3首<\/u>符合<u>高游玩性且同时满足适合进行脚谱编创<\/u>的歌曲作为<strong>『主题月歌曲』<\/strong><\/p><p><br><\/p><p>3.每月<strong>『主题月歌曲』<\/strong>的上线时间<u>暂定为隔月的25号<\/u>（如遇节假日，则可能提前或延后3-5个工作日）。请密切关注官方社群信息，以便获取最新动态。<\/p><p><br><\/p><h3><strong>『推荐歌曲』的推荐规则：<\/strong><\/h3><p>1.参与者需根据当期主题推荐符合要求的歌曲。<\/p><p>2.每期主题月活动中，一个账号最多可推荐三首歌曲。<\/p><p>3.每人每天可为歌曲贡献0.1%的<strong>『推荐值』，<\/strong>严禁恶意刷<strong>『推荐值』<\/strong>行为。<\/p><p>4.推荐的歌曲将在工作日48小时内进行审核。（春节期间，审核时间可能有所调整，请大家提前提交申请）<\/p><p><br><\/p><h3><strong>『推荐歌曲』的审核规则：<\/strong><\/h3><p>1. 歌曲重复：推荐歌曲已更新在e舞成名系列任一产品、任一模式中；<\/p><p>2. 内容错误：推荐歌曲信息错误，无法在互联网上找到该歌曲信息；<\/p><p>3. 内容不合法：推荐歌曲信息存在非法内容，或该歌曲不适合更新；<\/p><p>4. 其它原因：请留意审核结果通知提示；<\/p><p>5. 作品显示“e5已更新”，表示该作品将更新至e舞成名网络版对应的模式或DIY模式；&nbsp;<\/p><p>6. 作品显示“云曲库已更新”，表示该作品将更新至云曲库，e5+、e舞十周年纪念版和舞影随行和升级版同步更新；&nbsp;<\/p><p>7. 作品显示“全部已更新”，表示该作品将在e舞成名网络版、云曲库更新<\/p><p><br><\/p>\",\"beginTime\":\"2025-09-16 15:00:00\",\"endTime\":\"2025-10-15 23:59:59\",\"dayCount\":1,\"sameCount\":1,\"visitCount\":12385,\"optionCount\":171,\"createTime\":\"2025-09-16 11:04:52\",\"updateTime\":\"2025-10-24 16:26:50\",\"status\":3,\"imageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/1A\/1A226B04B749592EFD9D69BE68650C4AAF450FC1BD0D91B856D1D697B41506F9.jpeg\",\"voteCount\":8649,\"personCount\":1262,\"uid\":2548,\"themeType\":0,\"topFlag\":1,\"voted\":false,\"imageUrl2\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/08\/088EE452E8DCEEA1E350CAD81A7CF9234CC0B2EB85B73EC2E2DEC34D358498EA.jpeg\",\"rstImageUrl\":\"https:\/\/wt-media-pro.singworld.cn\/oms\/1A\/1A226B04B749592EFD9D69BE68650C4AAF450FC1BD0D91B856D1D697B41506F9.jpeg\",\"recommendNum\":3,\"redeemNum\":0,\"redeemTotalNum\":0,\"isWpl\":0,\"activityType\":1,\"genreList\":[17,19]},{\"id\":724,\"name\":\"8月歌曲荐歌行动\",\"showDesc\":1,\"themeDesc\":\"<h3><strong>什么是『主题月歌曲』荐歌行动？<\/strong><\/h3><p><strong>『主题月歌曲』<\/strong>荐歌行动是一个按月轮换主题<strong>『推荐歌曲』<\/strong>的推荐活动。活动设花式、竞速等模式，每月主题各异。<\/p><p>每月根据设定的主题，玩家可推荐喜爱歌曲，通过贡献<strong>『推荐值』<\/strong>，让歌曲进入<strong>『入围圈』<\/strong>；官方根据适合脚谱编创的要求再从<strong>『入围圈』<\/strong>挑选出<u>1-3首<\/u>作为<strong>『主题月歌曲』<\/strong>进行上线。<\/p><p>*花式模式的主题目前暂定为<u>中文流行、街舞、宅舞、MV原舞<\/u>这四种舞蹈风格轮换；竞速模式的主题则暂定为<u>中文流行、欧美流行、日语流行、韩文流行<\/u>这四种语种的歌曲轮换。具体主题可能会根据活动安排有所变动，请以当月官方公布的主题为准。<\/p><p><br><\/p><h3><strong>『主题月歌曲』上榜规则：<\/strong><\/h3><p>1.<strong>『推荐值』<\/strong>优先达到<u>100%<\/u>的歌曲，将稳固入驻<strong>『入围圈』<\/strong>，随后，其余歌曲将依据<strong>『推荐值』<\/strong>从高到低排序。在活动日期截止后，最终进入<strong>『入围圈』<\/strong>的<u>30首歌曲<\/u>将有机会被挑选作为<strong>『主题月歌曲』<\/strong>。<\/p><p><u>*若第30名与第31名歌曲的<\/u><strong><u>『推荐值』<\/u><\/strong><u>相同，则将依据两首歌曲达到该<\/u><strong><u>『推荐值』<\/u><\/strong><u>的时间先后顺序进行排序，从而进入<\/u><strong><u>『入围圈』<\/u><\/strong><u>。<\/u><\/p><p><br><\/p><p><strong>2.在活动结束后，官方谱师将从『入围圈』<\/strong>中精心挑选<u>1-3首<\/u>符合<u>高游玩性且同时满足适合进行脚谱编创<\/u>的歌曲作为<strong>『主题月歌曲』<\/strong><\/p><p><br><\/p><p><br><\/p><h3><strong>『推荐歌曲』的推荐规则：<\/strong><\/h3><p>1.参与者需根据当期主题推荐符合要求的歌曲。<\/p><p>2.每期主题月活动中，一个账号最多可推荐三首歌曲。<\/p><p>3.每人每天可为歌曲贡献0.1%的<strong>『推荐值』，<\/strong>严禁恶意刷<strong>『推荐值』<\/strong>行为。<\/p><p>4.推荐的歌曲将在工作日48小时内进行审核。<\/p><p><br><\/p><h3><strong>『推荐歌曲』的审核规则：<\/strong><\/h3><p>1. 歌曲重复：推荐歌曲已更新在e舞成名系列任一产品、任一模式中；<\/p><p>2. 内容错误：推荐歌曲信息错误，无法在互联网上找到该歌曲信息；<\/p><p>3. 内容不合法：推荐歌曲信息存在非法内容，或该歌曲不适合更新；<\/p><p>4. 其它原因：请留意审核结果通知提示；<\/p><p>5. 作品显示“e5已更新”，表示该作品将更新至e舞成名网络版对应的模式或DIY模式；&nbsp;<\/p><p>6. 作品显示“云曲库已更新”，表示该作品将更新至云曲库，e5+、e舞十周年纪念版和舞影随行和升级版同步更新；&nbsp;<\/p><p>7. 作品显示“全部已更新”，表示该作品将在e舞成名网络版、云曲库更新<\/p>\",\"beginTime\":\"2025-08-16 00:00:00\",\"endTime\":\"2025-09-15 23:59:39\",\"dayCount\":1,\"sameCount\":1,\"visitCount\":14027,\"optionCount\":148,\"createTime\":\"2025-08-15 14:17:08\",\"updateTime\":\"2025-08-20 10:27:26\",\"status\":5,\"imageUrl\"